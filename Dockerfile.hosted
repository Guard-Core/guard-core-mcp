ARG PYTHON_VERSION=3.10
FROM python:${PYTHON_VERSION}-slim

RUN apt-get update && apt-get install -y \
    libsodium23 \
    curl

WORKDIR /app

ENV PIP_NO_CACHE_DIR=false \
    PIP_DISABLE_PIP_VERSION_CHECK=on \
    PIP_DEFAULT_TIMEOUT=10 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    GUARD_CORE_MCP_HTTP_HOST=0.0.0.0 \
    GUARD_CORE_MCP_HTTP_PORT=8020

RUN pip install uv

COPY pyproject.toml uv.lock* README.md /app/

COPY guard_core_mcp/ /app/guard_core_mcp/

RUN uv sync --extra hosted --frozen --compile-bytecode

ENV PATH="/app/.venv/bin:$PATH"

RUN useradd --system --home /app --shell /usr/sbin/nologin guard \
    && chown -R guard:guard /app

USER guard

EXPOSE 8020

CMD ["guard-core-mcp-http"]
