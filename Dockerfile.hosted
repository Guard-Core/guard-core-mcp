FROM ghcr.io/astral-sh/uv:0.13.4@sha256:9f130421e930bfbdc563c00740466603f8723158e90297d07957c2294640262b AS uv

FROM python:3.14-slim@sha256:9aaa474097d094040649f2162a627c0049b408f52138d980916788d80f04802f AS builder

COPY --from=uv /uv /uvx /bin/

WORKDIR /app

ENV UV_LINK_MODE=copy \
    UV_NO_CACHE=1

COPY pyproject.toml uv.lock README.md /app/

COPY guard_core_mcp/ /app/guard_core_mcp/

RUN uv sync --locked --extra hosted --compile-bytecode

FROM python:3.14-slim@sha256:9aaa474097d094040649f2162a627c0049b408f52138d980916788d80f04802f

# Nothing at runtime installs a package, so the image carries neither pip (and the certifi, msgpack, setuptools and urllib3 it vendors) nor uv (and its rustls): both stay in the builder stage.
# Drop the zlib1g line once the base image ships 1:1.3.dfsg+really1.3.1-1+deb13u1 (CVE-2026-76844, CVE-2026-85091, CVE-2026-27171); the compare fails the build on a stale mirror.
RUN apt-get update \
    && apt-get install -y --no-install-recommends --only-upgrade zlib1g \
    && rm -rf /var/lib/apt/lists/* \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' zlib1g)" ge '1:1.3.dfsg+really1.3.1-1+deb13u1' \
    && python -m pip uninstall --yes pip \
    && rm -rf /usr/local/lib/python3.14/ensurepip \
    && useradd --system --uid 10001 --home /app --shell /usr/sbin/nologin guard \
    && mkdir /app \
    && chown guard:guard /app

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    GUARD_CORE_MCP_HTTP_HOST=0.0.0.0 \
    GUARD_CORE_MCP_HTTP_PORT=8020

USER 10001

COPY --from=builder --chown=guard:guard /app /app

ENV PATH="/app/.venv/bin:$PATH"

EXPOSE 8020

# The server card needs no token, so a 200 there means the app is serving.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD ["python", "-c", "import os, urllib.request; h = os.environ.get('GUARD_CORE_MCP_HTTP_HOST', '127.0.0.1'); h = '127.0.0.1' if h in ('0.0.0.0', '::') else h; urllib.request.urlopen('http://' + h + ':' + os.environ.get('GUARD_CORE_MCP_HTTP_PORT', '8020') + '/.well-known/mcp/server-card.json', timeout=3)"]

CMD ["guard-core-mcp-http"]
